# ==============================================================================
# KaleidoscopeV2 Configuration Template (SAFE TEMPLATE - DO NOT COMMIT .env)
# ==============================================================================
# 1. Copy this file to `.env`:
#      PowerShell : copy .env.example .env
#      Bash       : cp .env.example .env
# 2. Customize values for your machine/workspace.
# 3. NEVER commit `.env` or `KALEIDOSCOPE_PROFILE_DIR` to Git!

# Target Google Flow URL.
# You may use the root URL or paste a specific workspace/project URL after signing in:
# Example: https://flow.google.com/project/00000000-0000-0000-0000-000000000000
FLOW_PROJECT_URL=https://flow.google.com/

# Directory storing the persistent Chromium/Edge user profile (keeps Google login active)
KALEIDOSCOPE_PROFILE_DIR=./browser_profile

# Root output directory for composite 16:9 sheets and sliced 1024x1024 views
KALEIDOSCOPE_OUTPUT_DIR=./outputs

# Playwright browser channel: msedge | chrome | chromium
KALEIDOSCOPE_BROWSER_CHANNEL=msedge

# Optional explicit browser binary path (leave blank to auto-detect or use channel above)
# Windows Edge default : C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Linux Chrome example : /usr/bin/google-chrome
KALEIDOSCOPE_BROWSER_PATH=

# Run browser in headless mode (true recommended for automation, false for visual debug)
KALEIDOSCOPE_HEADLESS=true

# Maximum wait time in seconds per image generation
KALEIDOSCOPE_TIMEOUT_SEC=120

# Output square view resolution (pixels) and white margin padding ratio (0.08 = 8%)
KALEIDOSCOPE_VIEW_SIZE=1024
KALEIDOSCOPE_PAD_RATIO=0.08
